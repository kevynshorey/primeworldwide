{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "scripts/scrapeListings.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/scrape",
      "methods": ["GET"],
      "dest": "/api/scrape"
    }
  ],
  "functions": {
    "api/scrape.ts": {
      "runtime": "nodejs18.x",
      "schedule": "0 3 * * 0"
    }
  }
}